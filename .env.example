# Copy this file to .env and fill in real values. Never commit the real .env file.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Leave DATABASE_URL unset to use local SQLite automatically.
# Get this exact connection string from Supabase Dashboard -> Connect.
# Use the Session Pooler connection if your network is IPv4-only.
DATABASE_URL=postgresql://postgres.lvneaachewwumbfrdqqw:[YOUR_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Settings -> Storage -> S3 Connection.
SUPABASE_STORAGE_ACCESS_KEY=
SUPABASE_STORAGE_SECRET_KEY=
SUPABASE_PROJECT_REF=